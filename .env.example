# Same Clerk application as app., rep. and audit.qualifiedcommercial.com (one
# session across the subdomains). Copy the LIVE keys (pk_live_/sk_live_) from
# the QC-Audit or QCDashboard Amplify env vars. Do NOT copy from QCWeb: the
# marketing site runs on a different Clerk instance (pk_test_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Bare origin. The /api/v1 suffix is appended in src/lib/api.ts.
NEXT_PUBLIC_API_URL=https://api.qualifiedcommercial.com

# Where a login that is not a capital partner is sent.
NEXT_PUBLIC_FUNDING_APP_URL=https://app.qualifiedcommercial.com

# Review the portal without a backend: 1 serves sample data from src/lib/mock.ts.
# NEXT_PUBLIC_API_MOCK=1
# NEXT_PUBLIC_API_MOCK_STATUS=approved   # approved | waiting | questionnaire | preview | wall
